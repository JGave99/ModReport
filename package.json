{
  "name": "modreport",
  "version": "0.2.1",
  "private": true,
  "description": "ModReport — refertazione modulare per radiologi (sito statico + Supabase)",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/sql/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:sql": "node --test \"tests/sql/*.test.mjs\"",
    "check:lancio": "node scripts/check-lancio.mjs",
    "test:e2e": "playwright test",
    "lint": "node scripts/check-syntax.mjs",
    "icons": "node scripts/icons.mjs",
    "render-icons": "node scripts/render-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@expo-google-fonts/inter": "0.4.2",
    "@fontsource-variable/inter": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "2.117.2",
    "lucide-static": "^1.52.0",
    "pdf-lib": "1.17.1"
  },
  "engines": {
    "node": ">=22"
  }
}
